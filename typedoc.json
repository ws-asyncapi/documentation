{
	"$schema": "https://typedoc.org/schema.json",
	"plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
	"tsconfig": "./tsconfig.typedoc.json",
	"out": "docs/api",
	"entryPointStrategy": "resolve",
	"//": "entryPoints are provided programmatically by scripts/generate-typedoc.ts (staged from node_modules into .api-entries/ for clean module names).",
	"name": "ws-asyncapi API",
	"readme": "none",
	"githubPages": false,
	"hideGenerator": true,
	"excludeInternal": true,
	"excludePrivate": true,
	"sort": ["source-order"],
	"skipErrorChecking": true
}
